    "Files and names are encrypted before they upload. Without the password, nobody can read them, including you." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos e os nomes são criptografados antes do envio. Sem a senha, ninguém consegue lê-los, nem mesmo você."
          }
        }
      }
    },
    "Files you have not opened for the longest time are removed first. Open files and pending uploads stay, so the cache can go over the limit." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos que você abriu há mais tempo são removidos primeiro. Arquivos abertos e envios pendentes permanecem, então o cache pode passar do limite."
          }
        }
      }
    },
