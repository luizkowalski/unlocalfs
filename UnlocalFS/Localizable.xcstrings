      },
      "comment": "Accessibility label of the segmented control that switches editor panes"
    },
    "Select files in an UnlocalFS drive.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione arquivos em uma unidade do UnlocalFS."
