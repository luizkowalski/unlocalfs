/* SFTPSettings validation */
"Enter the server's host name or IP address." = "Informe o nome do servidor ou o endereço IP.";
"Enter a port from 1 to 65535." = "Informe uma porta de 1 a 65535.";
"Enter the username for this server." = "Informe o usuário deste servidor.";
"Enter a folder path without control characters, or leave it empty for your home folder." = "Informe um caminho de pasta sem caracteres de controle, ou deixe vazio para usar sua pasta pessoal.";
