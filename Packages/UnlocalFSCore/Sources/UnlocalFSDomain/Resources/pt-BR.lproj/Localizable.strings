/* Brazilian Portuguese translations. */

/* Connection validation */
"Name cannot be empty" = "O nome não pode ficar vazio";
"Enter a drive name without slashes, colons, or control characters." = "Informe um nome de unidade sem barras, dois-pontos ou caracteres de controle.";
"Enter a shorter drive name. The limit is 120 bytes." = "Informe um nome de unidade mais curto. O limite é de 120 bytes.";
"Endpoint must be a valid URL" = "O endpoint precisa ser uma URL válida";
"Enter an HTTP or HTTPS service endpoint without a bucket, credentials, or query." = "Informe um endpoint de serviço HTTP ou HTTPS sem bucket, credenciais ou consulta.";
"Bucket cannot be empty" = "O bucket não pode ficar vazio";
"Enter the bucket name, without a path." = "Informe o nome do bucket, sem caminho.";
"Enter a folder path like clients/acme, or leave it empty to use the whole bucket." = "Informe um caminho de pasta como clientes/acme, ou deixe vazio para usar o bucket inteiro.";
"A drive with that name already exists." = "Já existe uma unidade com esse nome.";
"The passwords do not match." = "As senhas não coincidem.";
"Access key cannot be empty" = "A chave de acesso não pode ficar vazia";
"Secret key cannot be empty" = "A chave secreta não pode ficar vazia";
"Password cannot be empty" = "A senha não pode ficar vazia";
"Import a service-account key" = "Importe uma chave de conta de serviço";
"Encryption password cannot be empty" = "A senha de criptografia não pode ficar vazia";

