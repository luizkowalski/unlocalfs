    "serverKeyChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server key for %1$@ changed. Check the new fingerprint with its administrator before you replace the trusted key.\n\n%2$@"
          }
        },
        "pt-BR" : {
