    "folderPathInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a folder path like clients/acme, or leave it empty to use the whole bucket."
          }
        },
        "pt-BR": {
