{
  "sourceLanguage": "en",
  "strings": {
    "accessKeyEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access key cannot be empty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de acesso não pode ficar vazia"
          }
        }
      }
    },
    "authenticationAgent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH agent"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente SSH"
          }
        }
      },
      "comment": "Authentication method: use the ssh-agent program"
    },
    "bucketEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket cannot be empty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bucket não pode ficar vazio"
          }
        }
      }
    },
    "bucketHasPath": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the bucket name, without a path."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o nome do bucket, sem caminho."
          }
        }
      }
    },
    "disconnectBeforeDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect this drive before deleting it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecte esta unidade antes de excluí-la."
          }
        }
      }
    },
    "disconnectBeforeQuitting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect your drives before quitting. This keeps pending uploads safe. Closing the window leaves UnlocalFS in the menu bar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecte suas unidades antes de sair. Isso preserva os envios pendentes. Fechar a janela mantém o UnlocalFS na barra de menus."
          }
        }
      }
    },
    "duplicateChangesLockedAttributes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate this drive to change its protocol, folder, or encryption."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplique esta unidade para mudar o protocolo, a pasta ou a criptografia."
          }
        }
      }
    },
    "duplicateName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ copy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — cópia"
          }
        }
      },
      "comment": "Name of a duplicated connection; %1$@ is the original name"
    },
    "encryptionPasswordEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encryption password cannot be empty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha de criptografia não pode ficar vazia"
          }
        }
      }
    },
    "encryptionPasswordImmutable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot change the encryption password of a saved drive. Duplicate the drive to use a new password."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível mudar a senha de criptografia de uma unidade salva. Duplique a unidade para usar uma nova senha."
          }
        }
      }
    },
    "endpointInvalidURL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint must be a valid URL"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endpoint precisa ser uma URL válida"
          }
        }
      }
    },
    "endpointNotDirect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an HTTP or HTTPS service endpoint without a bucket, credentials, or query."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um endpoint de serviço HTTP ou HTTPS sem bucket, credenciais ou parâmetros de consulta."
          }
        }
      }
    },
    "failedUploadsNeedRetry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not upload and need a retry. Keep UnlocalFS running until uploads finish."
