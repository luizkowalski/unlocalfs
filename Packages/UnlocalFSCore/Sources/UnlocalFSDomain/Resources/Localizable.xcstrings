        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o caminho completo do seu arquivo de chave privada, por exemplo ~/.ssh/id_ed25519."
          }
        }
      }
    },
    "linksUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links aren't available for %1$@ drives."
