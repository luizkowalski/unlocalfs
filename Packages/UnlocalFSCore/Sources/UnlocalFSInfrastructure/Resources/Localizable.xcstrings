{
  "sourceLanguage": "en",
  "strings": {
    "agentUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-agent is not available. Start your ssh-agent and load a key, or enter the agent's socket path in the connection."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ssh-agent não está disponível. Inicie seu ssh-agent e carregue uma chave, ou informe o caminho do socket do agente na conexão."
          }
        }
      }
    },
    "alreadyConnecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This drive is already connecting."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta unidade já está conectando."
          }
        }
      }
    },
    "alreadyRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This drive is already running. Disconnect it first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta unidade já está em execução. Desconecte-a primeiro."
          }
        }
      }
    },
    "cannotReadPrivateKeyFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UnlocalFS cannot read the private key file: %1$@\nChoose a file that exists and that you can read."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O UnlocalFS não consegue ler o arquivo de chave privada: %1$@\nEscolha um arquivo que exista e que você possa ler."
          }
        }
      }
    },
    "commandFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command failed. Try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando falhou. Tente novamente."
          }
        }
      }
    },
    "commandTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command timed out. Try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando expirou. Tente novamente."
          }
        }
      }
    },
    "controlServiceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive's control service is unavailable. Its cache will be kept.\n\n%1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de controle da unidade está indisponível. O cache será mantido.\n\n%1$@"
          }
        }
      }
    },
    "controlServiceUnavailableReconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive's control service is unavailable. Reconnect to restore the drive. Its cache will be kept."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de controle da unidade está indisponível. Reconecte para restaurá-la. O cache será mantido."
          }
        }
      }
    },
    "couldNotCreateLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create a link. Try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o link. Tente novamente."
          }
        }
      }
    },
    "couldNotCreateLinkUploading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create a link. If the file is still uploading, wait for it to finish.\n\n%1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o link. Se o arquivo ainda estiver sendo enviado, aguarde o término.\n\n%1$@"
          }
        }
      }
    },
    "couldNotEject": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not eject the drive. Close files using it and try again.\n\n%1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ejetar a unidade. Feche os arquivos em uso nela e tente novamente.\n\n%1$@"
          }
        }
      }
    },
    "couldNotMount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive could not mount. Open its log for details."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade não pôde ser montada. Abra o log dela para detalhes."
          }
        }
      }
    },
    "couldNotOpenLog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the drive log: %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o log da unidade: %1$@"
          }
        }
      }
    },
    "couldNotStopOldService": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not stop the old drive service because its process could not be identified. The cache was kept."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível parar o serviço antigo da unidade porque o processo dele não pôde ser identificado. O cache foi mantido."
          }
        }
      }
    },
    "driveStillMounted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is still mounted. Close files using it and try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade ainda está montada. Feche os arquivos em uso nela e tente novamente."
          }
        }
      }
    },
    "driveStillStopping": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is still stopping. Wait a moment and try disconnecting again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade ainda está encerrando. Aguarde um instante e tente desconectar novamente."
          }
        }
      }
    },
    "fileStillUploading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is still uploading. Wait for it to finish, then copy the link again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo ainda está sendo enviado. Aguarde o término e copie o link novamente."
          }
        }
      }
    },
    "folderEndsWithSpace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This drive's folder ends with a space, which rclone config files cannot keep. Rename the folder to export a config."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta desta unidade termina com um espaço, que os arquivos de configuração do rclone não conseguem preservar. Renomeie a pasta para exportar uma configuração."
          }
        }
      }
    },
    "keychainError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain error %1$d"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro do chaveiro %1$d"
          }
        }
      },
      "comment": "Fallback error message; %1$d is the macOS Keychain status code"
    },
    "keychainUnexpectedData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain returned unexpected data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chaveiro retornou dados inesperados."
          }
        }
      }
    },
    "mountFolderContainsFiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mount folder contains files. Move them before connecting: %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de montagem contém arquivos. Mova-os antes de conectar: %1$@"
          }
        }
      }
    },
    "mountTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive took too long to mount. Open its log for details."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade demorou demais para montar. Abra o log dela para detalhes."
          }
        }
      }
    },
    "reconnectForLinks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect the drive to create links. UnlocalFS can only create links through a connected drive."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte a unidade para criar links. O UnlocalFS só pode criar links por uma unidade conectada."
          }
        }
      }
    },
    "reconnectToCheckUploads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect the drive to create links. UnlocalFS could not check whether the file is still uploading.\n\n%1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte a unidade para criar links. O UnlocalFS não conseguiu verificar se o arquivo ainda está sendo enviado.\n\n%1$@"
          }
        }
      }
    },
    "serverTrustExpired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server trust changed while you were reviewing this key. Connect again to check the current key."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A confiança no servidor mudou enquanto você conferia esta chave. Conecte novamente para conferir a chave atual."
          }
        }
      }
    }
  },
  "version": "1.0"
}
