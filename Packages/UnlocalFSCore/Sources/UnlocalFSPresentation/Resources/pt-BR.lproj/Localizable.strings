/* Brazilian Portuguese translations. */

/* Drive status text */
"Working…" = "Trabalhando…";
"Needs reconnect" = "Precisa reconectar";
"Needs attention" = "Precisa de atenção";
"Checking…" = "Verificando…";
"Network unavailable" = "Rede indisponível";
"Upload needs attention" = "Envio precisa de atenção";
"%1$@ upload pending" = "%1$@ envio pendente";
"%1$@ uploads pending" = "%1$@ envios pendentes";
"Connected" = "Conectada";
"Ejected · disconnect to stop" = "Ejetada · desconecte para parar";
