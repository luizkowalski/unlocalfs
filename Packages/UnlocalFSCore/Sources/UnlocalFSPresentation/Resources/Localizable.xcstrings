    "noAbandonedUploads": {
      "comment": "Alert when no unfinished upload is old enough to remove; %1$@ is the drive name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has no unfinished uploads older than a day."
          }
