{
  "sourceLanguage": "en",
  "strings": {
    "abandonedUploadsExplanation": {
      "comment": "Confirmation message before removing unfinished uploads",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They stopped more than a day ago. Their parts are hidden in the bucket and still take up space. Your files do not change."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles pararam há mais de um dia. As partes deles ficam ocultas no bucket e ainda ocupam espaço. Seus arquivos não mudam."
          }
        }
      }
    },
    "abandonedUploadsRemain": {
      "comment": "Alert after cleanup when rclone could not remove some uploads; %lld is how many",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unfinished upload could not be removed. The log has the details."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unfinished uploads could not be removed. The log has the details."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld envio inacabado não pôde ser removido. O registro tem os detalhes."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld envios inacabados não puderam ser removidos. O registro tem os detalhes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld envios inacabados não puderam ser removidos. O registro tem os detalhes."
                }
              }
            }
          }
        }
      }
    },
