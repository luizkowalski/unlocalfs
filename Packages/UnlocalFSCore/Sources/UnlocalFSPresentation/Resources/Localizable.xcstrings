      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload needs attention"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envio precisa de atenção"
          }
        }
      }
    },
    "uploadsFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads failed on %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha nos envios em %1$@"
          }
        }
      }
    },
    "uploadsFailedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not upload. Keep the drive connected while UnlocalFS tries again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos não puderam ser enviados. Mantenha a unidade conectada enquanto o UnlocalFS tenta novamente."
          }
        }
      }
    },
    "uploadsFailedReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not upload: %1$@. UnlocalFS tries again while the drive stays connected."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos não puderam ser enviados: %1$@. O UnlocalFS tenta novamente enquanto a unidade estiver conectada."
          }
        }
      }
    },
    "uploadsPending": {
      "extractionState": "manual",
      "localizations": {
