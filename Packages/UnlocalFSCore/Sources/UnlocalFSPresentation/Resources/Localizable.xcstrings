        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não tem envios inacabados com mais de um dia."
          }
        }
      }
    },
    "recentUploadsKept": {
      "comment": "Added to the cleanup messages; %lld is how many unfinished uploads started in the last day",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld upload started in the last day stays because it may still be running."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld uploads started in the last day stay because they may still be running."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld envio iniciado no último dia é mantido porque ainda pode estar em andamento."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld envios iniciados no último dia ficam porque ainda podem estar em andamento."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld envios iniciados no último dia ficam porque ainda podem estar em andamento."
                }
              }
            }
          }
        }
