    "unfinishedUploadsRemovedBody": {
      "comment": "Notification body after cleanup; %1$@ is the drive name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their parts no longer take up space in %1$@."
          }
