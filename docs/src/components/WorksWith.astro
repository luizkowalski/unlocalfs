---
const providers = [
  { name: 'Amazon S3', logo: 'amazon-s3' },
  { name: 'Cloudflare R2', logo: 'cloudflare' },
  { name: 'Google Cloud Storage', logo: 'gcs' },
  { name: 'Google Drive', logo: 'google-drive' },
  { name: 'MinIO', logo: 'minio' },
  { name: 'Wasabi', logo: 'wasabi' },
  { name: 'DigitalOcean Spaces', logo: 'digital-ocean' },
  { name: 'SFTP', logo: 'sftp' },
];
---

<ul class="providers not-content" role="list">
  {providers.map(({ name, logo }) => (
    <li>
      <img src={`/providers/${logo}.svg`} alt="" width="36" height="36" data-monochrome={logo === 'sftp'} />
      <span>{name}</span>
    </li>
  ))}
</ul>

<style>
  .providers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    color: var(--sl-color-white);
  }

  img {
    object-fit: contain;
  }

  :global([data-theme='dark']) img[data-monochrome='true'] {
    filter: invert(1);
  }

  @media (max-width: 40rem) {
    .providers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
