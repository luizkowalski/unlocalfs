+import Foundation
+import Testing
+
+struct SharedS3Benchmark: SuiteTrait, TestScoping {
+    @TaskLocal static var server: (endpoint: String, root: URL)?
+
+    func provideScope(for test: Test, testCase: Test.Case?, performing function: @Sendable () async throws -> Void) async throws {
+        guard FileManager.default.fileExists(atPath: "/tmp/unlocalfs-shared-s3-benchmark-enabled") else {
+            try await function()
+            return
+        }
+        let executable = try await rcloneExecutable.value
+        try await withFixture { resources in
+            let source = resources.root.appending(path: "source")
+            try FileManager.default.createDirectory(at: source, withIntermediateDirectories: true)
+            let server = try await S3Server(executable: executable, resources: resources)
+            try await Self.$server.withValue((server.endpoint, source)) { try await function() }
+        }
+    }
+}
